    "index.js",
    "cordis.patch.yml",
    "preset-standard.patch.yml",
    "preset-ptc.patch.yml",
    "preset-minimal.patch.yml",
    "preset-cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset-standard.patch.yml",
        "./preset-ptc.patch.yml",
        "./preset-minimal.patch.yml",
        "./preset-cordis.patch.yml"
      ]
    }
  },
