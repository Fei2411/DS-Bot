{
  "name": "deepseek-bot-engine",
  "version": "0.2.1",
  "private": true,
  "description": "The engine layer of the DeepSeek Bot desktop app profile: transport, host services and the Bot agent preset over dsh-base, without the DSH Web front end.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "preset-standard.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset-standard.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-rc.4",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-file-upload": "0.2.1-rc.4",
    "@deepseek-ai/dsh-command-compact": "0.2.1-rc.4",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.4",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.1-rc.4",
    "@deepseek-ai/dsh-host-directory-picker-auto": "0.2.1-rc.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.4",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.4",
    "@deepseek-ai/dsh-plan-mode": "0.2.1-rc.4",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-stats": "0.2.1-rc.4",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-present": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-ralph": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-subagent-control": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-workflow": "0.2.1-rc.4",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.1-rc.4",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.4"
  }
}
