{
  "name": "dsbot-engine",
  "version": "0.2.1",
  "private": true,
  "description": "The engine layer of the DS Bot desktop app profile: transport, host services, UI dist server and built-in agent presets over dsh-base, without the DSH Web front end.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
