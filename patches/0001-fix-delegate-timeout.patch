diff --git a/ds-bot/src/host/handoffs.js b/ds-bot/src/host/handoffs.js
index 0dbaa81..fcf5dfe 100644
--- a/ds-bot/src/host/handoffs.js
+++ b/ds-bot/src/host/handoffs.js
@@ -326,5 +326,25 @@ export function install(rt) {
     return lines.join('; ')
