{
  "name": "ds-bot",
  "version": "0.4.0",
  "description": "DS Bot: a team of long-lived Bots for DeepSeek Harness, with Main Bots, Bot-to-Bot messages and group chats",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "bot",
    "multi-agent",
    "agents"
  ],
  "homepage": "https://github.com/Fei-Craft/DS-Bot#readme",
  "bugs": {
    "url": "https://github.com/Fei-Craft/DS-Bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fei-Craft/DS-Bot.git",
    "directory": "ds-bot"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "plugin.js",
  "exports": {
    ".": "./plugin.js",
    "./socket-tos-guard": "./src/host/socket-tos-guard.js",
    "./client": "./client.js",
    "./plugin-sdk": "./src/host/plugins/sdk.js",
    "./browser-provider": "./src/host/plugins/sdk.js",
    "./web-search": "./web-search.js",
    "./code-mode": "./code-mode.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/",
    "bin/",
    "plugin.js",
    "index.js",
    "src/host/",
    "src/client/agent-logos.js",
    "src/client/agent-routes.js",
    "src/client/inks.js",
    "src/shared/",
    "src/office/",
    "client.js",
    "link.js",
    "office.js",
    "web-search.js",
    "code-mode.js",
    "cordis.patch.yml",
    "assets/pwa/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-link.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test --test-timeout=120000 --test-force-exit \"test/*.test.js\"",
    "test:windows": "node --import ./test/harness-resolve.mjs --test --test-concurrency=2 --test-timeout=120000 --test-force-exit \"test/*.test.js\"",
    "test:browser": "node --import ./test/harness-resolve.mjs --test --test-concurrency=1 --test-timeout=120000 --test-force-exit \"test/browser/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm ci --prefix dev/harness --legacy-peer-deps=false --no-fund --no-audit",
    "check": "sh dev/check.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-fs-patch": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-ptc-runtime": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-tool-executor-native": "*",
    "@deepseek-ai/dsh-tool-executor-ptc": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-fs-patch": { "optional": true },
    "@deepseek-ai/dsh-ptc-runtime": { "optional": true },
    "@deepseek-ai/dsh-tool-executor-native": { "optional": true },
    "@deepseek-ai/dsh-tool-executor-ptc": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "deep-view": "0.1.2",
    "imapflow": "2.9.1",
    "jpeg-js": "0.4.4",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "saxes": "6.0.0",
    "semver": "^7.8.6",
    "undici": "8.11.2",
    "ws": "8.18.3"
  },
  "bin": {
    "ds-bot": "./bin/ds-bot-cli.mjs",
    "ds-bot-mcp": "./bin/ds-bot-mcp.mjs"
  }
}
