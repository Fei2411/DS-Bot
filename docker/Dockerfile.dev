# syntax=docker/dockerfile:1

# Build a template home for fresh data directories. At container start the
# supervisor replaces the packed plugin with a link to the mounted checkout.
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE} AS build

ARG NPM_REGISTRY=https://registry.npmjs.org/
ARG DSH_VERSION=0.2.2-rc.1

RUN corepack enable \
    && npm config set registry "$NPM_REGISTRY" --global \
    && COREPACK_NPM_REGISTRY="$NPM_REGISTRY" pnpm config set registry "$NPM_REGISTRY" --global \
    && npm install -g "@deepseek-ai/dsh@${DSH_VERSION}" \
        --allow-scripts=@deepseek-ai/dsh-subprocess-local,node-pty,koffi,@google/genai,protobufjs

COPY ds-bot/ /src/ds-bot/
RUN cd /src/ds-bot \
    && npm pack --pack-destination /tmp \
    && mv /tmp/ds-bot-*.tgz /tmp/ds-bot.tgz \
    && DSH_HOME=/opt/dsh-template dsh plugin --profile web add /tmp/ds-bot.tgz \
    && test -d /root/.local/share/pnpm/store

FROM ${NODE_IMAGE}
ARG NPM_REGISTRY=https://registry.npmjs.org/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash git curl ca-certificates \
        python3 python3-pip python3-venv \
        build-essential jq ripgrep unzip zip ffmpeg less procps gosu \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && npm config set registry "$NPM_REGISTRY" --global \
    && COREPACK_NPM_REGISTRY="$NPM_REGISTRY" pnpm config set registry "$NPM_REGISTRY" --global

COPY --from=build /usr/local/ /usr/local/
COPY --from=build /opt/dsh-template /opt/dsh-template
COPY --from=build /root/.local/share/pnpm/store /opt/pnpm-store
COPY --from=build /root/.cache/pnpm /opt/pnpm-cache/pnpm

# Keep pnpm in the image so profile linking does not fetch a package manager on
# every start. The mounted source still uses the DSH and toolchain in this image.
ENV COREPACK_HOME=/opt/corepack \
    XDG_CACHE_HOME=/opt/pnpm-cache
RUN corepack prepare pnpm@11.28.5 --activate \
    && chmod -R a+rwx "$COREPACK_HOME" /opt/pnpm-store /opt/pnpm-cache

WORKDIR /opt/ds-bot-deps
# .npmrc keeps npm from installing the DSH peer dependencies into this folder;
# the profile supplies those at runtime.
COPY ds-bot/package.json ds-bot/package-lock.json ds-bot/.npmrc ./
RUN npm ci --no-fund --no-audit

COPY docker/docker.patch.yml /opt/ds-bot/docker.patch.yml
COPY --chmod=0755 docker/dev-supervisor.mjs /opt/ds-bot/dev-supervisor.mjs
COPY --chmod=0755 docker/entrypoint.dev.sh /usr/local/bin/entrypoint.sh

ENV DSH_HOME=/data \
    DSH_PERMISSION_MODE=danger-full-access

WORKDIR /workspace
EXPOSE 3080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

LABEL org.opencontainers.image.title="DS Bot (dev)" \
      org.opencontainers.image.description="DS Bot from the mounted checkout, with source reload" \
      org.opencontainers.image.source="https://github.com/Fei2411/DS-Bot" \
      org.opencontainers.image.licenses="Apache-2.0"
