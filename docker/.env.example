# Copy to .env and fill in. docker compose reads .env in this directory.

# Your DeepSeek API key (or the key of the endpoint DEEPSEEK_BASE_URL names).
DEEPSEEK_API_KEY=

# Another Anthropic-Messages-compatible endpoint. Empty = the official one.
# From inside the container, host.docker.internal reaches the Docker host.
#DEEPSEEK_BASE_URL=

# Host names and addresses (no port) the web UI may be opened at, separated by
# commas. dsh web answers 403 on its API for any authority it does not trust,
# so list the NAS IP and every name you open it at. Loopback (localhost,
# 127.0.0.1) is always allowed.
DSH_TRUSTED_HOST=192.168.1.10

# Port on the Docker host the UI is published at (the container always
# listens on 3080 inside).
#DSH_PORT=3080

# Only with network_mode: host: the address and port dsh listens on directly.
# DSH_HOST=0.0.0.0 selects the container address; use a concrete host
# interface or 127.0.0.1 with network_mode: host.
#DSH_LISTEN_PORT=3080
#DSH_HOST=0.0.0.0

# User and group that own the data and workspace shares on the host.
# `id -u` and `id -g` of the NAS user that owns them.
#PUID=1000
#PGID=1000

# Where dsh keeps its data (team, chats, logins) and where the Bots work.
#DATA_DIR=./data
#WORKSPACE_DIR=./workspace

# dsh telemetry defaults to feedback-only (session logs leave the box only if
# you submit feedback). Set to 1 to turn it off entirely.
#DSH_TELEMETRY_DISABLED=1

# Build arguments (used by `docker compose build`, not at runtime).
# Mainland China: NPM_REGISTRY=https://registry.npmmirror.com/
#NPM_REGISTRY=https://registry.npmjs.org/
#DSH_VERSION=0.2.2-rc.1
