{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "dsbot-telemetry",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "telemetry.dsbot.app", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsbot-telemetry",
      "database_id": "<your-d1-database-id>"
    }
  ]
}
